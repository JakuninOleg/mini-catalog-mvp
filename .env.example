# Copy to .env. Replace all example secrets before exposing the proxy.
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=replace-with-random-database-password
DATABASE_URL=postgresql+asyncpg://catalog:replace-with-random-database-password@postgres:5432/catalog
MINIO_ROOT_USER=catalog-storage
MINIO_ROOT_PASSWORD=replace-with-random-storage-password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=catalog-storage
MINIO_SECRET_KEY=replace-with-random-storage-password
MINIO_BUCKET=catalog
MINIO_SECURE=false
BOT_API_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_WEBHOOK_SECRET=replace_with_32_or_more_random_characters
BOT_TOKEN=123456789:replace_with_real_token_from_BotFather
TELEGRAM_ADMIN_ID=123456789
MINI_APP_URL=https://catalog.example.com
BIND_ADDRESS=127.0.0.1
PORT=8080
